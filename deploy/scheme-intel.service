[Unit]
Description=Scheme-Intel 24/7 Telegram Conversational Intelligence Terminal
After=docker.service network-online.target
Requires=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/scheme-intel
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
