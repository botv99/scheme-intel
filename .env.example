# Scheme-Intel 24/7 Cloud Deployment Environment Configuration
# Copy this file to .env on your cloud VM (e.g., Oracle Cloud Always Free VM)
# chmod 600 .env

# ==========================================
# Telegram Configuration (REQUIRED for Gateway)
# ==========================================
# Bot token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Default Chat ID or User ID for notifications and reports
TELEGRAM_CHAT_ID=

# Automatically remove any conflicting webhook when starting long-polling
TELEGRAM_DELETE_WEBHOOK=true

# Optional: Restrict bot usage to specific Telegram user IDs (comma-separated).
# If empty, all authenticated chats can interact with the intelligence terminal.
TELEGRAM_ALLOWED_USER_IDS=

# ==========================================
# GitHub Configuration (for Event-Driven Actions)
# ==========================================
# GitHub Personal Access Token (classic with repo/workflow scope, or fine-grained Actions:write)
# Used by the Gateway to trigger 04-telegram-query.yml when user asks complex questions
GITHUB_TOKEN=

# Repository in owner/repo format
GITHUB_REPOSITORY=botv99/scheme-intel

# ==========================================
# LLM Providers (Optional for Gateway / Fast Path;
# used if VM executes ResearchWorker directly)
# ==========================================
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ==========================================
# Runtime & Health Check Configuration
# ==========================================
PORT=8080
PYTHONPATH=src
LOG_LEVEL=INFO
